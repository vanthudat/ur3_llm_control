<?xml version="1.0"?>
<sdf version="1.8">
  <world name="llm_robot">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics" />
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster" />
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <model name="table_camera_mount">
      <static>true</static>
      <!-- Put the support behind the camera so it stays out of the viewing cone. -->
      <pose>0.35 -1.05 0 0 0 0</pose>
      <link name="mount">
        <visual name="base">
          <cast_shadows>false</cast_shadows>
          <pose>0 0 0.025 0 0 0</pose>
          <geometry><cylinder><radius>0.10</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.12 0.14 0.16 1</ambient><diffuse>0.18 0.20 0.22 1</diffuse></material>
        </visual>
        <visual name="pole">
          <cast_shadows>false</cast_shadows>
          <pose>0 0 0.675 0 0 0</pose>
          <geometry><cylinder><radius>0.018</radius><length>1.35</length></cylinder></geometry>
          <material><ambient>0.12 0.14 0.16 1</ambient><diffuse>0.18 0.20 0.22 1</diffuse></material>
        </visual>
        <visual name="rear_camera_boom">
          <cast_shadows>false</cast_shadows>
          <!-- Short horizontal boom holds the camera forward of its side-view stand. -->
          <pose>0 0.125 1.35 0 0 0</pose>
          <geometry><box><size>0.030 0.25 0.030</size></box></geometry>
          <material><ambient>0.10 0.12 0.14 1</ambient><diffuse>0.16 0.18 0.20 1</diffuse></material>
        </visual>
        <visual name="boom_elbow">
          <cast_shadows>false</cast_shadows>
          <pose>0 0 1.35 0 0 0</pose>
          <geometry><sphere><radius>0.026</radius></sphere></geometry>
          <material><ambient>0.10 0.12 0.14 1</ambient><diffuse>0.16 0.18 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="table_camera">
      <static>true</static>
      <!-- Side-oblique view from the near edge of the table, aimed across the work surface. -->
      <pose>0.35 -0.75 1.35 0 0.681 1.57079632679</pose>
      <link name="link">
        <visual name="camera_body">
          <cast_shadows>false</cast_shadows>
          <!-- Keep the complete camera housing behind the sensor's optical plane. -->
          <pose>-0.075 0 0 0 0 0</pose>
          <geometry><box><size>0.12 0.15 0.095</size></box></geometry>
          <material><ambient>0.045 0.055 0.065 1</ambient><diffuse>0.075 0.09 0.105 1</diffuse></material>
        </visual>
        <visual name="rgb_lens_barrel">
          <cast_shadows>false</cast_shadows>
          <!-- Decorative lens stays behind the RGB-D sensor origin so it cannot occlude its image. -->
          <pose>-0.020 0 0 0 1.57079632679 0</pose>
          <geometry><cylinder><radius>0.038</radius><length>0.025</length></cylinder></geometry>
          <material><ambient>0.025 0.03 0.035 1</ambient><diffuse>0.04 0.05 0.06 1</diffuse></material>
        </visual>
        <visual name="rgb_lens_glass">
          <cast_shadows>false</cast_shadows>
          <pose>-0.005 0 0 0 1.57079632679 0</pose>
          <geometry><cylinder><radius>0.029</radius><length>0.003</length></cylinder></geometry>
          <material><ambient>0.015 0.12 0.28 1</ambient><diffuse>0.025 0.28 0.62 1</diffuse></material>
        </visual>
        <visual name="depth_lens_barrel">
          <cast_shadows>false</cast_shadows>
          <pose>-0.020 0.048 0 0 1.57079632679 0</pose>
          <geometry><cylinder><radius>0.018</radius><length>0.022</length></cylinder></geometry>
          <material><ambient>0.025 0.03 0.035 1</ambient><diffuse>0.04 0.05 0.06 1</diffuse></material>
        </visual>
        <visual name="depth_lens_glass">
          <cast_shadows>false</cast_shadows>
          <pose>-0.005 0.048 0 0 1.57079632679 0</pose>
          <geometry><cylinder><radius>0.012</radius><length>0.003</length></cylinder></geometry>
          <material><ambient>0.015 0.12 0.28 1</ambient><diffuse>0.025 0.28 0.62 1</diffuse></material>
        </visual>
        <sensor name="rgbd" type="rgbd_camera">
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <topic>/table_camera</topic>
          <camera>
            <horizontal_fov>1.308996939</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>3</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>
    <scene>
      <ambient>0.75 0.75 0.75 1</ambient>
      <background>0.82 0.86 0.90 1</background>
      <shadows>true</shadows>
    </scene>
