<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="simple_gripper" params="parent prefix:='' sim_ignition:=false">
    <link name="${prefix}simple_gripper_base_link">
      <visual>
        <origin xyz="0 0 0.020" rpy="0 0 0"/>
        <geometry><box size="0.080 0.120 0.040"/></geometry>
        <material name="simple_gripper_body"><color rgba="0.18 0.20 0.22 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.020" rpy="0 0 0"/>
        <geometry><box size="0.080 0.120 0.040"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.020" rpy="0 0 0"/>
        <mass value="0.20"/>
        <inertia ixx="0.00014" ixy="0" ixz="0" iyy="0.00007" iyz="0" izz="0.00016"/>
      </inertial>
    </link>

    <link name="${prefix}gripper_fixed_finger_link">
      <visual>
        <origin xyz="0 0 0.045" rpy="0 0 0"/>
        <geometry><box size="0.022 0.018 0.090"/></geometry>
        <material name="simple_gripper_finger"><color rgba="0.32 0.34 0.37 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.045" rpy="0 0 0"/>
        <geometry><box size="0.022 0.018 0.090"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.045" rpy="0 0 0"/>
        <mass value="0.03"/>
        <inertia ixx="0.000009" ixy="0" ixz="0" iyy="0.000009" iyz="0" izz="0.000001"/>
      </inertial>
    </link>

    <link name="${prefix}gripper_moving_finger_link">
      <visual>
        <origin xyz="0 0 0.045" rpy="0 0 0"/>
        <geometry><box size="0.022 0.018 0.090"/></geometry>
        <material name="simple_gripper_finger"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.045" rpy="0 0 0"/>
        <geometry><box size="0.022 0.018 0.090"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.045" rpy="0 0 0"/>
        <mass value="0.03"/>
        <inertia ixx="0.000009" ixy="0" ixz="0" iyy="0.000009" iyz="0" izz="0.000001"/>
      </inertial>
    </link>

    <joint name="${prefix}simple_gripper_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}simple_gripper_base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <joint name="${prefix}gripper_fixed_finger_joint" type="prismatic">
      <parent link="${prefix}simple_gripper_base_link"/>
      <child link="${prefix}gripper_fixed_finger_link"/>
      <origin xyz="0 0.045 0.043" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="0.0" upper="0.015" effort="40" velocity="0.05"/>
    </joint>
    <joint name="${prefix}gripper_finger_joint" type="prismatic">
      <parent link="${prefix}simple_gripper_base_link"/>
      <child link="${prefix}gripper_moving_finger_link"/>
      <origin xyz="0 -0.045 0.043" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="0.015" effort="40" velocity="0.05"/>
    </joint>

    <xacro:if value="${sim_ignition}">
      <ros2_control name="${prefix}SimpleGripperSystem" type="system">
        <hardware><plugin>ign_ros2_control/IgnitionSystem</plugin></hardware>
        <joint name="${prefix}gripper_finger_joint">
          <command_interface name="position"><param name="min">0.0</param><param name="max">0.015</param></command_interface>
          <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
          <state_interface name="velocity"/>
        </joint>
        <joint name="${prefix}gripper_fixed_finger_joint">
          <command_interface name="position"><param name="min">0.0</param><param name="max">0.015</param></command_interface>
          <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
          <state_interface name="velocity"/>
        </joint>
      </ros2_control>
    </xacro:if>
  </xacro:macro>
</robot>
