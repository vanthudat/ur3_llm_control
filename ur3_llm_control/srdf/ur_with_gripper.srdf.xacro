<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">
  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="prefix" default=""/>

  <xacro:include filename="$(find ur_moveit_config)/srdf/ur_macro.srdf.xacro"/>
  <xacro:ur_srdf name="$(arg name)" prefix="$(arg prefix)"/>

  <!-- Connected links intentionally touch at their mounting faces. -->
  <disable_collisions link1="$(arg prefix)tool0"
                      link2="$(arg prefix)simple_gripper_base_link" reason="Adjacent"/>
  <disable_collisions link1="$(arg prefix)wrist_3_link"
                      link2="$(arg prefix)simple_gripper_base_link" reason="Adjacent"/>
  <disable_collisions link1="$(arg prefix)simple_gripper_base_link"
                      link2="$(arg prefix)gripper_fixed_finger_link" reason="Adjacent"/>
  <disable_collisions link1="$(arg prefix)simple_gripper_base_link"
                      link2="$(arg prefix)gripper_moving_finger_link" reason="Adjacent"/>
</robot>
